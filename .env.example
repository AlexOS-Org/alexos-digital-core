# Supabase project configuration.
# Copy this file to `.env` for local development and fill in the values from
# your Supabase project (Project Settings → API). The live deployment must
# have these values configured as environment variables / secrets in the
# hosting environment (e.g. Cloudflare) or the build will produce broken bundles.
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only Meta Ads Manager and Ads Webhooks configuration.
META_ACCESS_TOKEN=your_server_side_meta_ads_read_token
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=replace_with_a_long_random_verification_token
META_GRAPH_API_VERSION=v23.0
META_GRAPH_TIMEOUT_MS=15000
META_SYNC_CACHE_TTL_MS=300000
